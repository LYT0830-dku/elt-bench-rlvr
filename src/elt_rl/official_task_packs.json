    "sources": [
      {
        "name": "employee",
        "kind": "postgres",
        "options": {
          "path": "sources/employee.csv",
          "format": "csv",
          "initial_types": {
            "ssn": "TEXT",
            "lastname": "TEXT",
            "firstname": "TEXT",
            "hiredate": "DATE",
            "salary": "TEXT",
            "gender": "TEXT",
            "performance": "TEXT",
            "positionid": "INTEGER",
            "locationid": "INTEGER"
          },
          "initial_primary_keys": [
            "ssn"
          ],
          "initial_date_format": "%m/%d/%y"
        }
      },
      {
        "name": "position",
        "kind": "s3",
        "options": {
          "path": "sources/position.csv",
          "format": "csv",
          "key": "position.csv"
        }
      },
      {
        "name": "location",
        "kind": "csv_http",
        "options": {
          "path": "sources/location.csv",
          "format": "csv",
          "url_path": "/human_resources/location.csv"
        }
      }
    ],
    "targets": {
      "positions": {
        "keys": [
          "position_id"
        ],
        "numeric": [
          "position_id",
          "num_poor_performing_employees",
          "num_female_employees",
          "per_salary_over_20000",
          "avg_salary",
          "has_maximum_salary_no_more_than_70000"
